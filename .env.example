# =====================================================================
#  Cấu hình Memorable Desktop: đổi ở đây là đủ, không phải sửa trong mã.
#  Chép tệp này thành .env rồi sửa giá trị. Sau khi đổi: chạy lại
#  "npm run dev" (khi phát triển) hoặc "npm run dist" (đóng gói bản cài).
#  Thiếu dòng nào thì dùng giá trị mặc định trong electron/appConfig.cjs.
#  Không ghi mật khẩu hay khóa bí mật vào đây: các giá trị MEMORABLE_*
#  được đóng gói vào ứng dụng.
# =====================================================================

# Địa chỉ máy chủ Memorable API mặc định (người dùng vẫn đổi được ở màn đăng nhập)
MEMORABLE_SERVER=https://memorable.clearlink.io.vn

# Địa chỉ cũ: máy nào đang lưu một trong các địa chỉ này sẽ tự chuyển sang MEMORABLE_SERVER
# (nhiều địa chỉ cách nhau bằng dấu phẩy)
MEMORABLE_LEGACY_SERVERS=http://26.118.183.122:3001

# Máy chủ dùng khi mở giao diện trong trình duyệt lúc phát triển (không có Electron)
MEMORABLE_DEV_SERVER=http://localhost:3001

# Thời gian chờ máy chủ (giây): gọi API thường / tải tệp về / gửi tệp lên (AI đọc tệp lâu)
MEMORABLE_TIMEOUT_SEC=30
MEMORABLE_DOWNLOAD_TIMEOUT_SEC=120
MEMORABLE_UPLOAD_TIMEOUT_SEC=900

# Dung lượng tối đa mỗi tệp (MB), phải khớp với máy chủ (MAX_UPLOAD_MB của backend)
MEMORABLE_MAX_UPLOAD_MB=10
MEMORABLE_MAX_AUDIO_MB=25

# Chỉ dùng cho script "npm run api:check": thư mục mã nguồn backend
BACKEND_DIR=../Memorable
