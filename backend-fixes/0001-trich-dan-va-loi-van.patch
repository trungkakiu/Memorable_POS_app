--- /dev/null
+++ b/tests/citeText.test.js
@@ -0,0 +1,27 @@
+// Chuẩn hóa trích dẫn và lời văn hiển thị cho người dùng cuối
+const { normalizeCites, normalizeDeep, CITE_RULE, PLAIN_RULE } = require('../src/services/ai/citeText');
+
+describe('normalizeCites', () => {
+  const ids = new Set([44, 46]);
+  test('[ID] của tài liệu thật thành [doc:ID]', () => {
+    expect(normalizeCites('Quy tắc gồm 3 phần [44].', ids)).toBe('Quy tắc gồm 3 phần [doc:44].');
+    expect(normalizeCites('Theo [44, 46] thì', ids)).toBe('Theo [doc:44] [doc:46] thì');
+  });
+  test('giữ nguyên ngoặc số không phải id tài liệu', () => {
+    expect(normalizeCites('Bước [1] rồi [2]', ids)).toBe('Bước [1] rồi [2]');
+  });
+  test('gỡ [doc:ID] không thuộc tài liệu đã gửi', () => {
+    expect(normalizeCites('Nguồn [doc:99] bịa và [doc:44] thật', ids)).toBe('Nguồn bịa và [doc:44] thật');
+  });
+  test('nhận Map làm tập id và bỏ qua giá trị không phải chuỗi', () => {
+    expect(normalizeCites('[46]', new Map([[46, {}]]))).toBe('[doc:46]');
+    expect(normalizeCites(null, ids)).toBeNull();
+  });
+  test('normalizeDeep chỉ đổi chuỗi, giữ số và mảng id', () => {
+    expect(normalizeDeep({ summary: '[44] và [46]', item_ids: [44], n: 2 }, ids)).toEqual({ summary: '[doc:44] và [doc:46]', item_ids: [44], n: 2 });
+  });
+  test('quy tắc prompt yêu cầu [doc:ID] và lời văn không kỹ thuật', () => {
+    expect(CITE_RULE).toMatch(/\[doc:ID\]/);
+    expect(PLAIN_RULE).toMatch(/non-technical/);
+  });
+});
