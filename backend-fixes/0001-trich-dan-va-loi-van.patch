+// Quy tắc trình bày câu trả lời cho người dùng cuối (nhiều người không rành công nghệ):
+// - trích nguồn thống nhất dạng [doc:ID] (giao diện đổi thành liên kết mở tài liệu);
+// - không lộ nhãn kỹ thuật nội bộ (tier, approved, OCR...) trong văn bản hiển thị.
+
+const CITE_RULE = 'In every text field shown to the user, cite a team document right after the sentence it supports as [doc:ID] (for example [doc:12]). Never write a bare [12], "doc 12" or "document 12".';
+
+const PLAIN_RULE = [
+  'The readers are non-technical staff. In user-facing text never use internal labels such as tier, official, reviewed, unreviewed, stale, approved, OCR, chunk or passage.',
+  'Say instead (in Vietnamese): "nguồn chính thống", "đã kiểm duyệt", "chưa được kiểm duyệt", "đã quá hạn rà soát", "chữ đọc từ ảnh, chưa ai kiểm tra".',
+  'Address the reader as "bạn".',
+].join(' ');
+
+/**
+ * Chuẩn hóa trích dẫn trong văn bản AI trả về:
+ * - [12] hoặc [doc:12] của tài liệu thật (có trong validIds) -> [doc:12]
+ * - [doc:99] không thuộc tài liệu đã gửi -> gỡ bỏ (AI bịa nguồn)
+ * - [3] không phải id tài liệu -> giữ nguyên (có thể là chú thích thường)
+ */
+const normalizeCites = (text, validIds) => {
+  if (typeof text !== 'string' || !text) return text;
+  const ok = validIds instanceof Map || validIds instanceof Set ? validIds : new Set(validIds || []);
+  return text
+    .replace(/\[(doc:)?(\d+(?:\s*[,;]\s*\d+)*)\]/g, (all, prefixed, list) => {
+      const ids = list.split(/\s*[,;]\s*/).map(Number);
+      if (ids.every((id) => ok.has(id))) return ids.map((id) => `[doc:${id}]`).join(' ');
+      if (!prefixed) return all;
+      const keep = ids.filter((id) => ok.has(id));
+      return keep.map((id) => `[doc:${id}]`).join(' ');
+    })
+    .replace(/[ \t]{2,}/g, ' ');
+};
+
+/** Áp dụng normalizeCites cho mọi chuỗi trong một đối tượng/mảng (giữ nguyên số, id). */
+const normalizeDeep = (value, validIds) => {
+  if (typeof value === 'string') return normalizeCites(value, validIds);
+  if (Array.isArray(value)) return value.map((v) => normalizeDeep(v, validIds));
+  if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value).map(([k, v]) => [k, normalizeDeep(v, validIds)]));
+  return value;
+};
+
+const WITHHELD_VI = 'Câu trả lời không dẫn được tài liệu nào hợp lệ nên đã bị giữ lại.';
+const WITHHELD_PART_VI = 'Phần được cho là lấy từ tài liệu không dẫn được nguồn hợp lệ nên đã bị giữ lại.';
+const COMPARE_NOTE_VI = 'So sánh bằng AI chỉ để hỗ trợ đọc. Hãy đối chiếu các điểm quan trọng với tài liệu gốc.';
+
+module.exports = { CITE_RULE, PLAIN_RULE, normalizeCites, normalizeDeep, WITHHELD_VI, WITHHELD_PART_VI, COMPARE_NOTE_VI };
