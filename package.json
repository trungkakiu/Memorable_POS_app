{
  "name": "memorable-desktop",
  "productName": "Memorable Desktop",
  "version": "1.0.0",
  "description": "Ứng dụng máy tính cho Memorable API – kho tri thức & vận hành nhóm",
  "author": "Memorable",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "icon": "node scripts/make-icon.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win --x64",
    "vosk": "node scripts/copy-vosk.cjs",
    "api:check": "node scripts/api-watch.cjs",
    "api:accept": "node scripts/api-watch.cjs --accept"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vosk-browser": "^0.0.8",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "vn.memorable.desktop",
    "productName": "Memorable Desktop",
    "copyright": "Memorable",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Memorable Desktop",
      "installerLanguages": [
        "vi_VN",
        "en_US"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "electronDist": "node_modules/electron/dist",
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
